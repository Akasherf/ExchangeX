{
  "id": null,
  "uid": "exchangex-sprint6",
  "title": "ExchangeX \u00b7 Trading and Runtime",
  "description": "Bounded per-symbol metrics sourced from committed PostgreSQL state; runtime Micrometer metrics",
  "tags": [
    "exchangex",
    "sprint6"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Command checkpoint by symbol",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "exchangex-prometheus"
      },
      "targets": [
        {
          "expr": "exchangex_instrument_checkpoint_sequence",
          "refId": "A",
          "legendFormat": "{{symbol}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Committed trades by symbol",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "exchangex-prometheus"
      },
      "targets": [
        {
          "expr": "exchangex_instrument_trades_committed",
          "refId": "A",
          "legendFormat": "{{symbol}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Open resting orders",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "exchangex-prometheus"
      },
      "targets": [
        {
          "expr": "exchangex_instrument_orders_open",
          "refId": "A",
          "legendFormat": "{{symbol}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "JVM heap in use",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "exchangex-prometheus"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "refId": "A",
          "legendFormat": "Heap"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP request throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "exchangex-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))",
          "refId": "A",
          "legendFormat": "Requests/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "API HTTP 5xx rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "exchangex-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
          "refId": "A",
          "legendFormat": "5xx/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
